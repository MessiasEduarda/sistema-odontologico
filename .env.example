# Copie para .env (que NÃO é versionado):  cp .env.example .env
# Valores abaixo são exclusivos para desenvolvimento local. Em produção, gere senhas fortes e
# configure-as no provedor (nunca no repositório).

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=odonto
POSTGRES_PORT=5433
# Superusuário: só para administração do container, nunca usado pela aplicação.
POSTGRES_ADMIN_USER=odonto_admin
POSTGRES_ADMIN_PASSWORD=troque_admin_dev
# Papel do Flyway (dono do schema, executa DDL).
MIGRATOR_DB_USER=odonto_migrator
MIGRATOR_DB_PASSWORD=odonto_migrator_dev
# Papel da aplicação (apenas DML, sujeito a RLS).
APP_DB_USER=odonto_app
APP_DB_PASSWORD=odonto_app_dev
APP_DB_SCHEMA=odonto

# --- Mailpit ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- API: URLs, e-mail e sessão ---
# Endereço público do front-end (usado nos links enviados por e-mail).
APP_PUBLIC_URL=http://localhost:3000
# SMTP (em desenvolvimento, o Mailpit captura tudo em http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=nao-responda@odontosaas.example
# Produção (perfil prod): use os dados do provedor de e-mail (ex.: Brevo, Resend, Mailjet, SMTP2GO).
#   SMTP_HOST=smtp.provedor.com   SMTP_PORT=587   SMTP_USERNAME=...   SMTP_PASSWORD=(chave SMTP do provedor)
#   MAIL_FROM=nao-responda@seudominio.com.br (remetente verificado no provedor, com SPF e DKIM no domínio)
#   APP_PUBLIC_URL=https://seudominio.com.br
# No perfil prod, autenticação e STARTTLS já vêm ligados e a conexão é testada ao iniciar. Só mude se o provedor pedir:
# SMTP_AUTH=true
# SMTP_STARTTLS=true            (porta 587)
# SMTP_SSL=false                (porta 465: SMTP_SSL=true e SMTP_STARTTLS=false)
# SMTP_TEST_CONNECTION=true
# Cookie de sessão só por HTTPS. Em produção deve ser true (padrão fora do perfil dev).
COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=12h

# --- Primeiro administrador da plataforma (produção) ---
# Criado na inicialização apenas se ainda não existir nenhum. Remova a senha do ambiente depois do primeiro uso.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# --- Dados fictícios de desenvolvimento (somente perfil dev) ---
DEV_SEED_ENABLED=true
DEV_SEED_PASSWORD=Odonto@Dev2026
